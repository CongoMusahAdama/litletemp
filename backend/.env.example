# The backend runs on Vercel inside the Next.js project (src/pages/api).
# Set these in Vercel → Project → Settings → Environment Variables.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/littletemp?retryWrites=true&w=majority
JWT_SECRET=paste-a-long-random-string

# Live updates (messages, typing, online status, calls, games): ably.com → your app → API keys.
ABLY_API_KEY=appId.keyId:secret

# Protects the daily job at /api/cron/daily (Vercel Cron sends it automatically).
CRON_SECRET=paste-another-random-string

# Added by Vercel when the Blob store is connected; uploads go straight to it.
BLOB_READ_WRITE_TOKEN=

# Only needed when running the API on its own with `node server.js`.
CLIENT_ORIGIN=*
PORT=3005
